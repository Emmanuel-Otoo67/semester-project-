# Browser-safe Supabase Auth settings. Use the project's URL and publishable key.
# Not required by local development mode; local sign-in is disabled there.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>
# Set true only when using the local-dev Spring profile and local PostgreSQL.
VITE_LIBTRACK_LOCAL_DEV=false
# Leave empty for local Vite proxy; set to the deployed Spring API origin in production.
VITE_API_BASE_URL=

# API runtime database role: least privilege, no schema-changing rights.
SUPABASE_APP_DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SUPABASE_APP_DB_USER=<runtime-role>
SUPABASE_APP_DB_PASSWORD=<runtime-password>

# Separate migration role: used only by Flyway during controlled deployments.
SUPABASE_FLYWAY_DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SUPABASE_FLYWAY_DB_USER=<migration-role>
SUPABASE_FLYWAY_DB_PASSWORD=<migration-password>
# Disabled by default; set true only for local setup or a controlled migration run.
FLYWAY_ENABLED=false

# Supabase Auth JWT validation. Issuer is https://<project-ref>.supabase.co/auth/v1.
SUPABASE_AUTH_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1
SUPABASE_AUTH_AUDIENCE=authenticated
# JWKS for asymmetric project signing; LEGACY_HS256 validates remotely through Auth /user.
SUPABASE_AUTH_JWT_MODE=JWKS
# Required only for LEGACY_HS256 mode; this publishable key is not a secret.
SUPABASE_AUTH_PUBLISHABLE_KEY=sb_publishable_<public-key>

# Local PostgreSQL fallback for Docker Compose.
LIBTRACK_DB_URL=jdbc:postgresql://localhost:5433/libtrack
LIBTRACK_DB_USER=libtrack
LIBTRACK_DB_PASSWORD=libtrack_dev_password

# Comma-separated exact UI origins allowed to call the API.
LIBTRACK_CORS_ORIGINS=http://localhost:5173

