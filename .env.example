# Local development defaults. For Supabase, set SUPABASE_DB_URL, SUPABASE_DB_USER,
# and SUPABASE_DB_PASSWORD from Project Settings > Database > Connection string (JDBC).
LIBTRACK_DB_URL=jdbc:postgresql://localhost:5433/libtrack
LIBTRACK_DB_USER=libtrack
LIBTRACK_DB_PASSWORD=libtrack_dev_password

# Required for the starter HTTP Basic authentication. Use a unique password locally
# and a managed secret in deployment. Authentication will evolve to staff accounts.
LIBTRACK_ADMIN_USERNAME=admin
LIBTRACK_ADMIN_PASSWORD=change-this-before-running

# React dev server URL allowed to call the API.
LIBTRACK_CORS_ORIGIN=http://localhost:5173

